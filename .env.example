# Server & Profile
SERVER_PORT=8101
SPRING_PROFILES_ACTIVE=dev

# Database (used when SPRING_PROFILES_ACTIVE=docker)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=flashsale
DB_USERNAME=flashsale
DB_PASSWORD=change-me-in-local-docker-env
POSTGRES_PORT=5431

# Redis (used when SPRING_PROFILES_ACTIVE=docker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6381

# JWT Authentication (replace with a strong 32+ byte Base64 or UTF-8 secret outside dev)
JWT_SECRET=dev-only-change-me-before-production-use-at-least-32-chars
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Application Behavior
ORDER_RESERVATION_TTL_SECONDS=900
ORDER_EXPIRY_JOB_ENABLED=true
ORDER_EXPIRY_JOB_DELAY_MS=30000
APP_SEED_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ORDER_CAPACITY=35
RATE_LIMIT_ORDER_REFILL_TOKENS=35
RATE_LIMIT_ORDER_REFILL_PERIOD_SECONDS=60
RATE_LIMIT_VOUCHER_CAPACITY=5
RATE_LIMIT_VOUCHER_REFILL_TOKENS=5
RATE_LIMIT_VOUCHER_REFILL_PERIOD_SECONDS=10
COMPOSE_PROJECT_NAME=be01_flashsale_order_api
